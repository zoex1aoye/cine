<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sideload-friendly: projectors often lack official Leanback; do not require it. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- 侧载兼容：LEANBACK_LAUNCHER 供 Google/Android TV 桌面，LAUNCHER 供第三方 TV 桌面与投影仪魔改 AOSP 桌面。
         两者显式写在同一个 filter 中，不依赖 main 清单的合并结果。 -->
    <application android:banner="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:banner="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
